---
import CartButton from './CartButton';
import OpenStatus from './OpenStatus';
import Postmark from './Postmark.astro';

const links: [string, string][] = [
  ['Menu', '/menu'],
  ['Order', '/order'],
  ['Reserve', '/reserve'],
  ['Story', '/story'],
  ['Gatherings', '/gatherings'],
  ['Trek Stop', '/trek-stop'],
  ['Visit', '/visit'],
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') {
    return currentPath === '/' || currentPath === '';
  }
  return currentPath.startsWith(href);
};
---

<header class="border-b border-ink/20 bg-paper">
  <a
    class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-paper focus:px-4 focus:py-3"
    href="#main-content"
  >
    Skip to content
  </a>
  <div class="ph-container flex min-h-20 items-center justify-between gap-5">
    <a
      class="flex items-center gap-3 no-underline"
      href="/"
      aria-label="The Pigeonhole Café home"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      <span class="hidden sm:block">
        <Postmark size={48} decorative />
      </span>
      <span class="font-display text-xl leading-none">The Pigeonhole Café</span>
      <span class="ph-label border border-stamp px-2 py-1 text-stamp">
        Demo
      </span>
    </a>
    <nav class="hidden items-center gap-5 md:flex" aria-label="Main navigation">
      {links.map(([label, href]) => {
        const active = isCurrent(href);
        return (
          <a
            class:list={[
              'text-sm transition-colors',
              active
                ? 'font-semibold text-ink underline decoration-brass decoration-2 underline-offset-8'
                : 'text-ink-2 hover:text-ink hover:underline hover:underline-offset-4',
            ]}
            href={href}
            aria-current={active ? 'page' : undefined}
          >
            {label}
          </a>
        );
      })}
    </nav>
    <div class="hidden items-center gap-3 lg:flex">
      <OpenStatus client:load />
      <CartButton client:load />
    </div>
    <details class="relative md:hidden">
      <summary
        class="ph-label flex min-h-11 cursor-pointer list-none items-center border border-ink px-4"
        aria-label="Open navigation menu"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 z-50 mt-2 grid min-w-56 border border-ink bg-paper shadow-ledger"
        aria-label="Mobile navigation"
      >
        {links.map(([label, href]) => {
          const active = isCurrent(href);
          return (
            <a
              class:list={[
                'min-h-11 border-b border-ink/20 px-4 py-3 no-underline last:border-0',
                active
                  ? 'bg-ink font-semibold text-paper'
                  : 'text-ink hover:bg-paper-2',
              ]}
              href={href}
              aria-current={active ? 'page' : undefined}
            >
              {label}
            </a>
          );
        })}
        <a
          class="min-h-11 px-4 py-3 no-underline hover:bg-paper-2"
          href="/order"
          aria-current={isCurrent('/order') ? 'page' : undefined}
        >
          Cart
        </a>
      </nav>
    </details>
  </div>
  <div class="ph-container flex items-center justify-between gap-3 border-t border-ink/15 py-2 lg:hidden">
    <OpenStatus client:load />
    <CartButton client:load />
  </div>
</header>
