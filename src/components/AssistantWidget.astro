<aside
  class="fixed right-4 bottom-4 z-40 sm:right-6 sm:bottom-6"
  aria-label="Café assistant preview"
>
  <button
    id="assistant-open"
    class="flex min-h-14 items-center gap-3 border border-ink bg-ink px-5 font-semibold text-paper shadow-ledger"
    type="button"
    aria-haspopup="dialog"
  >
    <span class="font-display text-xl text-brass">PH</span> Ask the café
  </button>
  <dialog
    id="assistant-dialog"
    class="m-0 h-full max-h-none w-full max-w-none bg-paper p-0 text-ink backdrop:bg-ink/70 sm:top-auto sm:right-6 sm:bottom-24 sm:left-auto sm:h-auto sm:w-[min(28rem,calc(100vw-3rem))] sm:border sm:border-ink"
  >
    <section
      class="grid max-h-full grid-rows-[auto_1fr_auto]"
      aria-labelledby="assistant-title"
    >
      <header class="flex items-start justify-between gap-4 border-b border-ink p-5">
        <div>
          <h2 id="assistant-title" class="text-2xl">
            Ask the café
          </h2>
          <p class="mt-1 text-sm text-ink-2">A preview of the assistant.</p>
        </div>
        <button
          id="assistant-close"
          class="min-h-11 border border-ink px-4"
          type="button"
        >
          Close
        </button>
      </header>
      <div class="p-5">
        <p>
          The assistant will answer from written café facts in a later phase.
        </p>
        <p class="mt-4 text-sm text-ink-2">
          For allergies, always speak to the team.
        </p>
      </div>
      <p class="border-t border-ink p-5 text-sm text-ink-2">
        No message is sent from this preview.
      </p>
    </section>
  </dialog>
</aside>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#assistant-dialog');
  const open = () => dialog?.showModal();
  document.querySelector('#assistant-open')?.addEventListener('click', open);
  document
    .querySelector('#assistant-close')
    ?.addEventListener('click', () => dialog?.close());
  document.addEventListener('click', (event) => {
    const target =
      event.target instanceof Element
        ? event.target.closest('[data-open-assistant]')
        : null;
    if (target) open();
  });
</script>
