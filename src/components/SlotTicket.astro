---
interface Props {
  code: string;
  slot?: string;
  date: string;
  time: string;
  partySize?: number;
  status: string;
  kind?: 'booking' | 'order';
}
const {
  code,
  slot,
  date,
  time,
  partySize,
  status,
  kind = 'booking',
} = Astro.props;
---

<article class="ticket" data-ticket aria-label={`${status} booking ${code}`}>
  <div class="body">
    <p class="ph-label text-ink-2">
      {kind === 'order' ? 'Takeaway receipt' : 'Booking receipt'}
    </p>
    <h3 data-ticket-code>{code}</h3>
    <dl>
      <div>
        <dt>Date</dt>
        <dd data-ticket-date>{date}</dd>
      </div>
      <div>
        <dt>Time</dt>
        <dd data-ticket-time>{time}</dd>
      </div>
      {kind === 'booking' && (
        <div>
          <dt>Party</dt>
          <dd data-ticket-party>{partySize}</dd>
        </div>
      )}
    </dl>
  </div>
  <div class="stub">
    <span class="ph-label" data-ticket-status>
      {status}
    </span>
    <strong data-ticket-slot>{slot ?? 'PICKUP'}</strong>
    <span class="ph-label">
      {kind === 'order' ? 'Pay at pickup' : 'Hold 15 min'}
    </span>
  </div>
</article>

<style>
  .ticket {
    position: relative;
    display: flex;
    max-width: 580px;
    border: 1px solid var(--ink);
    background: var(--card);
    filter: drop-shadow(0 16px 20px rgba(27, 36, 48, 0.12));
  }
  .body {
    min-width: 0;
    flex: 1;
    padding: 24px;
  }
  h3 {
    margin-top: 8px;
    font-size: clamp(1.75rem, 5vw, 2.6rem);
    overflow-wrap: anywhere;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0 0;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  dd {
    margin: 4px 0 0;
  }
  .stub {
    display: flex;
    width: 164px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-left: 2px dashed var(--ink);
    background: var(--paper-2);
    padding: 24px 16px;
    text-align: center;
  }
  .stub strong {
    font-family: var(--font-mono);
    font-size: clamp(1.15rem, 3vw, 1.5rem);
    line-height: 1.15;
    overflow-wrap: break-word;
  }
  @media (max-width: 39.99rem) {
    .ticket {
      flex-direction: column;
    }
    .stub {
      width: auto;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 12px;
      border-top: 2px dashed var(--ink);
      border-left: 0;
    }
  }
</style>
