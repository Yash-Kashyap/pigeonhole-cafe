---
import DietBadges from './DietBadges.astro';
import Price from './Price.astro';
interface Props {
  id: string;
  name: string;
  description: string;
  price: number;
  vegan?: boolean;
  jain?: boolean;
  glutenFree?: boolean;
  spice?: 0 | 1 | 2 | 3;
  allergens?: string[];
  prepMinutes?: number;
  tags?: string[];
  addOn?: boolean;
  unavailable?: boolean;
}
const {
  id,
  name,
  description,
  price,
  vegan,
  jain,
  glutenFree,
  spice = 0,
  allergens = [],
  prepMinutes,
  tags = [],
  addOn = false,
  unavailable = false,
} = Astro.props;
const shownTags = tags.filter((tag) =>
  ['signature', 'popular', 'seasonal', 'offer', 'kids'].includes(tag),
);
---

<article class="grid gap-4 border-t border-ink py-5 sm:grid-cols-[1fr_auto]">
  <div class="space-y-2">
    <h3 class="text-2xl">{name}</h3>
    <p class="max-w-2xl text-sm text-ink-2">{description}</p>
    <DietBadges {vegan} {jain} {glutenFree} {spice} />
    <p class="text-xs text-ink-2">
      {allergens.length
        ? `Contains: ${allergens.join(', ')}`
        : 'No listed allergens'}
    </p>
    {prepMinutes && <p class="text-xs text-ink-2">about {prepMinutes} min</p>}
    {shownTags.length > 0 && (
      <p class="flex flex-wrap gap-2">
        {shownTags.map((tag) => (
          <span class="ph-label border border-ink/30 px-2 py-1">{tag}</span>
        ))}
      </p>
    )}
  </div>
  <div class="flex items-start justify-between gap-4 sm:flex-col sm:items-end">
    <span>
      {addOn && '+ '}
      <Price value={price} />
    </span>
    <button
      class:list={[
        'min-h-11 border px-4 text-sm font-semibold transition',
        unavailable
          ? 'border-ink/40 opacity-60 cursor-not-allowed'
          : 'border-ink bg-transparent text-ink hover:bg-ink hover:text-paper',
      ]}
      type="button"
      disabled={unavailable}
      data-add-to-cart={id}
      data-item-name={name}
      aria-label={
        unavailable ? `${name} is sold out today` : `Add ${name} to cart`
      }
    >
      {unavailable ? 'Sold out today' : 'Add'}
    </button>
  </div>
</article>
