---
export type FilledCell = {
  index: number;
  label: string;
  price?: string | number;
  itemId?: string;
  icon?: 'mug' | 'book' | 'jar';
};

interface Props {
  rows?: number;
  cols?: number;
  filledCells?: FilledCell[];
  label?: string;
  decorative?: boolean;
  interactive?: boolean;
  caption?: string;
  /** CSS aspect-ratio of the whole wall on tablet and desktop. A wide strip needs something like "5/1". */
  aspect?: string;
}

const {
  rows = 6,
  cols = 8,
  filledCells = [],
  label = 'A wall of wooden pigeonholes',
  decorative = false,
  interactive = false,
  caption,
  aspect = '4/3',
} = Astro.props;

const filled = new Map(filledCells.map((cell) => [cell.index, cell]));
const total = rows * cols;
---

<figure class="wall-wrapper">
  <div
    class="wall"
    class:list={[
      'wall',
      `wall-${rows}-${cols}`,
      aspect === '5/1' && 'wall-wide',
    ]}
    role={decorative ? undefined : interactive ? 'group' : 'img'}
    aria-hidden={decorative ? 'true' : undefined}
    aria-label={decorative ? undefined : label}
  >
    {Array.from({ length: total }, (_, index) => {
      const cell = filled.get(index);
      const isDesktopOnly = index >= 16;
      if (cell && interactive) {
        const priceText =
          cell.price !== undefined
            ? typeof cell.price === 'number'
              ? `$${cell.price.toFixed(2)}`
              : cell.price
            : '';
        const tipText = priceText ? `${cell.label} · ${priceText}` : cell.label;
        return (
          <button
            class:list={[
              'cell',
              'filled',
              'cell-btn',
              isDesktopOnly && 'desktop-only',
            ]}
            type="button"
            data-scroll-item={cell.itemId}
            aria-label={`Show ${cell.label}`}
          >
            {cell.icon === 'mug' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M6 8h11v9a3 3 0 0 1-3 3h-5a3 3 0 0 1-3-3zM17 11h2a2 2 0 0 1 0 4h-2M9 3c0 2 2 2 2 4M13 3c0 2 2 2 2 4" />
              </svg>
            )}
            {cell.icon === 'book' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 5h12a2 2 0 0 1 2 2v12H7a2 2 0 0 1-2-2zM8 5v14" />
              </svg>
            )}
            {cell.icon === 'jar' && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7 4h10v3H7zM6 7h12v13H6zM9 12h6" />
              </svg>
            )}
            <span class="tip" aria-hidden="true">
              {tipText}
            </span>
          </button>
        );
      }
      return (
        <span
          class:list={[
            'cell',
            cell && 'filled',
            isDesktopOnly && 'desktop-only',
          ]}
          aria-hidden="true"
        >
          {cell?.icon === 'mug' && (
            <svg viewBox="0 0 24 24">
              <path d="M6 8h11v9a3 3 0 0 1-3 3h-5a3 3 0 0 1-3-3zM17 11h2a2 2 0 0 1 0 4h-2M9 3c0 2 2 2 2 4M13 3c0 2 2 2 2 4" />
            </svg>
          )}
          {cell?.icon === 'book' && (
            <svg viewBox="0 0 24 24">
              <path d="M5 5h12a2 2 0 0 1 2 2v12H7a2 2 0 0 1-2-2zM8 5v14" />
            </svg>
          )}
          {cell?.icon === 'jar' && (
            <svg viewBox="0 0 24 24">
              <path d="M7 4h10v3H7zM6 7h12v13H6zM9 12h6" />
            </svg>
          )}
          {cell && <span class="sr-only">{cell.label}</span>}
        </span>
      );
    })}
  </div>
  {caption && (
    <figcaption class="ph-label mt-3 text-center text-ink-2">
      {caption}
    </figcaption>
  )}
</figure>

<script>
  document.addEventListener('click', (event) => {
    const target =
      event.target instanceof Element
        ? event.target.closest('[data-scroll-item]')
        : null;
    if (!target) return;
    const itemId = target.getAttribute('data-scroll-item');
    if (!itemId) return;
    const card = document.getElementById(`card-${itemId}`);
    if (card) {
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.add('outline-brass-highlight');
      setTimeout(() => {
        card.classList.remove('outline-brass-highlight');
      }, 2000);
      const focusTarget = card.querySelector<HTMLElement>('button, a') || card;
      focusTarget.focus();
    }
  });
</script>

<style>
  .wall-wrapper {
    margin: 0;
  }
  .wall {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    grid-template-rows: repeat(6, minmax(0, 1fr));
    aspect-ratio: 4 / 3;
    gap: clamp(5px, 1vw, 10px);
    padding: clamp(10px, 2vw, 20px);
    background: var(--walnut);
    border: 1px solid var(--ink);
    box-shadow: inset 0 0 0 8px rgba(0, 0, 0, 0.12);
  }
  .wall-wide {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    aspect-ratio: 5 / 1;
  }
  .cell {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    background: #2f2119;
    border: 1px solid rgba(244, 237, 224, 0.14);
    box-shadow: inset 0 5px 12px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(5px);
    animation: cell-in 0.35s ease-out forwards;
  }
  .cell.filled {
    background: var(--paper-2);
    color: var(--ink);
  }
  .cell-btn {
    cursor: pointer;
    border: 0;
    padding: 0;
    font: inherit;
    box-shadow: inset 0 3px 8px rgba(27, 36, 48, 0.3);
  }
  .cell-btn:focus-visible {
    outline: 3px solid var(--brass);
    outline-offset: 2px;
  }
  .cell-btn .tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    padding: 4px 8px;
    display: none;
    pointer-events: none;
    z-index: 20;
    box-shadow: 0 4px 10px rgba(27, 36, 48, 0.2);
  }
  .cell-btn:hover .tip,
  .cell-btn:focus-visible .tip {
    display: block;
  }
  svg {
    width: 48%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.3;
  }
  @keyframes cell-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 39.99rem) {
    .wall {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      aspect-ratio: 1;
    }
    .cell.desktop-only {
      display: none;
    }
  }
</style>
