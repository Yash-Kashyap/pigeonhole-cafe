---
import BaseLayout from '../layouts/BaseLayout.astro';
import PigeonholeGrid from '../components/PigeonholeGrid.astro';
---

<BaseLayout
  title="The Pigeonhole Café | Foundation"
  description="The foundation for a fictional café demo in Kothi Bagh."
>
  <section class="ph-container grid items-center gap-10 py-16 md:grid-cols-2 md:py-24">
    <div class="space-y-6">
      <p class="ph-label text-stamp">Foundation dispatch</p>
      <h1 class="text-6xl sm:text-7xl">Sorted over chai.</h1>
      <p class="max-w-xl text-ink-2">
        The shared design system is ready. Public café pages arrive in the next
        phase.
      </p>
    </div>
    <PigeonholeGrid
      rows={6}
      cols={8}
      filledCells={[
        { index: 4, label: 'Mug', icon: 'mug' },
        { index: 21, label: 'Book', icon: 'book' },
        { index: 38, label: 'Tea jar', icon: 'jar' },
      ]}
    />
  </section>
</BaseLayout>
