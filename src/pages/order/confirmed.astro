---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Postmark from '../../components/Postmark.astro';
import SlotTicket from '../../components/SlotTicket.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import { readServerEnv } from '../../lib/server-env';
import { createServerSupabaseClient } from '../../lib/supabase/server';
import {
  buildOrderCalendarIcs,
  buildOrderWhatsAppText,
} from '../../lib/whatsapp';

export const prerender = false;
const code = Astro.url.searchParams.get('code') ?? '';
type ConfirmedOrder = {
  code: string;
  name: string;
  pickup_at: string;
  subtotal: number;
  status: string;
  order_items: { menu_item_id: string; name_snapshot: string; qty: number }[];
};
let order: ConfirmedOrder | null = null;
if (/^PH-ORD-\d{4,}$/.test(code)) {
  const client = createServerSupabaseClient(readServerEnv());
  const { data } = await client
    .from('orders')
    .select(
      'code,name,pickup_at,subtotal,status,order_items(menu_item_id,name_snapshot,qty)',
    )
    .eq('code', code)
    .maybeSingle();
  order = data as ConfirmedOrder | null;
}
if (!order) Astro.response.status = 404;
const pickup = order ? new Date(order.pickup_at) : null;
const pickupDate = pickup
  ? new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    }).format(pickup)
  : '';
const pickupTime = pickup
  ? new Intl.DateTimeFormat('en-US', {
      timeZone: 'Asia/Kolkata',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    }).format(pickup)
  : '';
const firstName = order?.name.trim().split(/\s+/)[0] ?? '';
const whatsappText = order
  ? buildOrderWhatsAppText({
      code: order.code,
      firstName,
      pickupAt: `${pickupDate}, ${pickupTime}`,
      items: order.order_items.map((item) => ({
        name: item.name_snapshot,
        qty: item.qty,
      })),
    })
  : '';
const calendar = order
  ? buildOrderCalendarIcs({ code: order.code, pickupAt: order.pickup_at })
  : '';
---

<BaseLayout
  title="Order confirmed | The Pigeonhole Café (demo)"
  description="Your demo takeaway order confirmation."
  noindex={true}
>
  <section class="ph-container py-12 md:py-20">
    {order ? (
      <div class="mx-auto max-w-3xl text-center">
        <div class="stamp-thunk mx-auto w-fit">
          <Postmark size={132} variant="stamp" decorative />
        </div>
        <p class="ph-label mt-6 text-stamp">Order confirmed · Demo</p>
        <h1 class="mt-3 text-5xl sm:text-6xl">Sorted for pickup.</h1>
        <p class="mt-4">Pay at pickup. Show this code at the counter.</p>
        <div class="mt-10 text-left">
          <SlotTicket
            code={order.code}
            date={pickupDate}
            time={pickupTime}
            status={order.status}
            kind="order"
          />
        </div>
        <p class="mt-5">
          <span
            id="order-status"
            data-order-code={order.code}
            class="inline-flex border border-ink px-3 py-1 font-mono text-xs uppercase"
          >
            {order.status}
          </span>
        </p>
        <section class="mt-10 border-y border-ink py-6 text-left">
          <h2 class="text-2xl">Your order</h2>
          <ul class="mt-4 grid gap-2">
            {order.order_items.map((item) => (
              <li class="flex justify-between gap-4">
                <span>{item.name_snapshot}</span>
                <span class="font-mono">× {item.qty}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 flex justify-between border-t border-ink pt-4 text-xl">
            <span>Subtotal</span>
            <span class="font-mono">${order.subtotal.toFixed(2)}</span>
          </p>
        </section>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <WhatsAppButton text={whatsappText} variant="solid">
            Send to the café on WhatsApp
          </WhatsAppButton>
          <a
            class="inline-flex min-h-11 items-center border border-ink px-5 font-semibold"
            href={`data:text/calendar;charset=utf-8,${encodeURIComponent(calendar)}`}
            download={`${order.code}.ics`}
          >
            Add to calendar
          </a>
          <button
            id="order-again"
            class="min-h-11 border border-ink px-5 font-semibold"
            type="button"
            data-items={JSON.stringify(
              order.order_items.map((item) => ({
                id: item.menu_item_id,
                quantity: item.qty,
              })),
            )}
          >
            Order again
          </button>
          <a
            class="inline-flex min-h-11 items-center border border-ink px-5 font-semibold"
            href="/menu"
          >
            Back to menu
          </a>
        </div>
      </div>
    ) : (
      <div class="mx-auto max-w-xl text-center">
        <p class="ph-label text-stamp">Order not found</p>
        <h1 class="mt-4 text-5xl">This order slip is missing.</h1>
        <p class="mt-5">Check the code, then try again.</p>
        <a
          class="mt-8 inline-flex min-h-11 items-center border border-ink bg-ink px-5 font-semibold text-paper"
          href="/menu"
        >
          Back to menu
        </a>
      </div>
    )}
  </section>
</BaseLayout>
<script>
  import { restoreOrderCart } from '../../lib/cart';

  const status = document.querySelector<HTMLElement>('#order-status');
  const code = status?.dataset.orderCode;
  const finished = new Set(['collected', 'cancelled']);

  if (status && code) {
    const timer = window.setInterval(async () => {
      if (document.hidden) return;
      try {
        const response = await fetch(
          `/api/orders/${encodeURIComponent(code)}`,
          {
            cache: 'no-store',
          },
        );
        const data: { status?: unknown } = await response.json();
        if (response.ok && typeof data.status === 'string') {
          status.textContent = data.status;
          if (finished.has(data.status)) window.clearInterval(timer);
        }
      } catch {
        /* the next tick tries again */
      }
    }, 10_000);
  }

  document
    .querySelector<HTMLButtonElement>('#order-again')
    ?.addEventListener('click', (event) => {
      const value = (event.currentTarget as HTMLElement).getAttribute(
        'data-items',
      );
      if (!value) return;
      try {
        restoreOrderCart(JSON.parse(value));
        window.location.assign('/order');
      } catch {
        /* malformed order data cannot restore a cart */
      }
    });
</script>
<style>
  .stamp-thunk {
    animation: thunk 180ms ease-out both;
  }
  @keyframes thunk {
    from {
      transform: scale(1.15);
    }
    to {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stamp-thunk {
      animation: none;
    }
  }
</style>
