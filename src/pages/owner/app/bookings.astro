---
import OwnerBookings from '../../../components/owner/OwnerBookings';
import OwnerLayout from '../../../layouts/OwnerLayout.astro';
import { getOwnerRealtimeProps } from '../../../lib/owner-page-props';

export const prerender = false;
const realtime = getOwnerRealtimeProps();
---

<OwnerLayout title="Bookings" active="bookings">
  <OwnerBookings
    client:load
    supabaseUrl={realtime.supabaseUrl}
    supabaseAnonKey={realtime.supabaseAnonKey}
  />
</OwnerLayout>
